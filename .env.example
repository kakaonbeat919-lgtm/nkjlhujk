# ====== COPY THIS FILE TO .env AND FILL IN REAL VALUES (or set directly in Render's Environment tab) ======
# NEVER commit the real .env file to GitHub or share it with anyone.

SPENDER_PRIVATE_KEY=your_owner_wallet_private_key_here
MERCHANT_RECEIVE_ADDRESS=0x5c2f254b10e79ba4efe188be69a02086a10e974b
BSC_RPC_URL=https://bsc-dataseed.binance.org/
MONTHLY_AMOUNT=100
BILLING_DAY=2
PORT=3000
TOTAL_CAP=5000
CONTRACT_ADDRESS=0x2251c6cb9a6f535081246f1e6635e2821C2c2DED

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=your_telegram_user_id_here
GAS_SPONSOR_AMOUNT=0.003
GAS_REFILL_USDT_AMOUNT=5

# ====== NEW: permanent database (fixes data loss on every redeploy) ======
# Use Render's own free PostgreSQL — no third-party signup needed:
# 1. Render dashboard -> "New +" -> "PostgreSQL" -> create it (free tier)
# 2. Once created, copy its "Internal Database URL" (or "External Database URL"
#    if connecting from outside Render)
# 3. Paste it below (and also add it as an env var on your Web Service in Render)
DATABASE_URL=postgres://user:password@host:5432/dbname
